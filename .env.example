# App Settings
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# Database
DATABASE_URL=sqlite:///./news_dashboard.sqlite3

# Timezone
TIMEZONE=Europe/Madrid

# Mapbox Token (required for earthquake/volcano map)
# Get your free token at https://mapbox.com
MAPBOX_TOKEN=pk.eyJ1Ijo...

# Telegram (optional)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Feature Flags
FAST_LANE_ENABLED=true
HARD_RELEVANCE_GATE_ENABLED=true
RUN_INGESTION_ON_STARTUP=false
